# 10. Метрики

def smape(y_true, y_pred):
    y_true = np.array(y_true)
    y_pred = np.array(y_pred)

    denom = (np.abs(y_true) + np.abs(y_pred)) / 2
    value = np.where(denom == 0, 0, np.abs(y_true - y_pred) / denom)

    return np.mean(value) * 100


def evaluate_model(y_true, y_pred):
    y_true = pd.Series(y_true).reset_index(drop=True)
    y_pred = pd.Series(y_pred).reset_index(drop=True)

    return {
        'MAE': mean_absolute_error(y_true, y_pred),
        'RMSE': np.sqrt(mean_squared_error(y_true, y_pred)),
        'SMAPE': smape(y_true, y_pred),
        'MedAE': median_absolute_error(y_true, y_pred)
    }

# 11.baseline-модели

def naive_forecast_horizon(series, horizon=1, test_size=12):
    train_size = len(series) - test_size
    preds = []
    dates = []

    for target_pos in range(train_size, len(series)):
        origin_pos = target_pos - horizon
        pred = series.iloc[origin_pos]

        preds.append(pred)
        dates.append(series.index[target_pos])

    return pd.Series(preds, index=dates)


def seasonal_naive_forecast_horizon(series, horizon=1, test_size=12, season=12):
    train_size = len(series) - test_size
    preds = []
    dates = []

    for target_pos in range(train_size, len(series)):
        seasonal_pos = target_pos - season

        if seasonal_pos >= 0:
            pred = series.iloc[seasonal_pos]
        else:
            pred = series.iloc[target_pos - horizon]

        preds.append(pred)
        dates.append(series.index[target_pos])

    return pd.Series(preds, index=dates)


def drift_naive_forecast_horizon(series, horizon=1, test_size=12):
    train_size = len(series) - test_size
    preds = []
    dates = []

    for target_pos in range(train_size, len(series)):
        origin_pos = target_pos - horizon
        history = series.iloc[:origin_pos + 1]

        mean_change = history.diff().dropna().mean()
        pred = history.iloc[-1] + horizon * mean_change

        preds.append(pred)
        dates.append(series.index[target_pos])

    return pd.Series(preds, index=dates)


def seasonal_drift_naive_forecast_horizon(series, horizon=1, test_size=12, season=12):
    train_size = len(series) - test_size
    preds = []
    dates = []

    for target_pos in range(train_size, len(series)):
        origin_pos = target_pos - horizon

        seasonal_pos = target_pos - season
        origin_seasonal_pos = origin_pos - season

        if seasonal_pos >= 0 and origin_seasonal_pos >= 0:
            seasonal_value = series.iloc[seasonal_pos]
            level_shift = series.iloc[origin_pos] - series.iloc[origin_seasonal_pos]
            pred = seasonal_value + level_shift
        else:
            pred = series.iloc[origin_pos]

        preds.append(pred)
        dates.append(series.index[target_pos])

    return pd.Series(preds, index=dates)


baseline_models = {
    'naive': naive_forecast_horizon,
    'seasonal_naive': seasonal_naive_forecast_horizon,
    'drift_naive': drift_naive_forecast_horizon,
    'seasonal_drift_naive': seasonal_drift_naive_forecast_horizon
}


def evaluate_baseline_model(series, model_func, test_size=12, horizons=[1, 2, 3]):
    horizon_results = []
    horizon_forecasts = {}

    for horizon in horizons:
        pred = model_func(
            series,
            horizon=horizon,
            test_size=test_size
        )

        y_true = series.loc[pred.index]
        metrics = evaluate_model(y_true, pred)

        horizon_results.append(metrics)
        horizon_forecasts[horizon] = pred

    avg_metrics = pd.DataFrame(horizon_results).mean().to_dict()

    return avg_metrics, horizon_forecasts

# 12. SARIMA walk-forward

def fit_sarima(history, data_version):
    if data_version == 'level':
        order = (1, 1, 0)
        seasonal_order = (1, 0, 0, 12)
    else:
        order = (1, 0, 0)
        seasonal_order = (1, 0, 0, 12)

    model = SARIMAX(
        history,
        order=order,
        seasonal_order=seasonal_order,
        enforce_stationarity=False,
        enforce_invertibility=False
    )

    return model.fit(disp=False)


def sarima_walk_forward(series, data_version, test_size=12):
    train_size = len(series) - test_size
    history = series.iloc[:train_size].copy()
    test = series.iloc[train_size:].copy()

    preds = []

    for date in test.index:
        model_fit = fit_sarima(history, data_version)
        pred = model_fit.forecast(steps=1).iloc[0]

        preds.append(pred)
        history.loc[date] = test.loc[date]

    return pd.Series(preds, index=test.index)

# 13 VAR walk-forward

var_targets = [
    'price_index_economy',
    'price_index_business'
]


def var_walk_forward(model_data, target_cols, test_size=12, maxlags=2):
    model_data = model_data[target_cols].dropna().copy()

    train_size = len(model_data) - test_size
    history = model_data.iloc[:train_size].copy()
    test = model_data.iloc[train_size:].copy()

    preds = []

    for date in test.index:
        lag = min(maxlags, max(1, len(history) // 10))

        model = VAR(history)
        model_fit = model.fit(lag)

        forecast = model_fit.forecast(
            history.values[-lag:],
            steps=1
        )[0]

        preds.append(forecast)

        history = pd.concat([history, test.loc[[date]]])

    preds = pd.DataFrame(
        preds,
        index=test.index,
        columns=target_cols
    )

    return preds

# 14 Ridge walk-forward

def make_ridge_train_features(train_data, target, features):
    train_frame = train_data[[target] + features].copy()

    train_frame[f'{target}_lag_1'] = train_frame[target].shift(1)
    train_frame[f'{target}_lag_12'] = train_frame[target].shift(12)

    return train_frame.dropna()


def ridge_walk_forward(model_data, target, features, test_size=12):
    model_data = model_data[[target] + features].dropna().copy()

    train_size = len(model_data) - test_size
    preds = []

    for i in range(train_size, len(model_data)):
        train_data = model_data.iloc[:i].copy()
        test_row = model_data.iloc[i:i+1].copy()

        train_features = make_ridge_train_features(
            train_data,
            target,
            features
        )

        X_train = train_features.drop(columns=[target])
        y_train = train_features[target]

        test_features = {}

        for col in features:
            test_features[col] = test_row[col].iloc[0]

        test_features[f'{target}_lag_1'] = train_data[target].iloc[-1]
        test_features[f'{target}_lag_12'] = train_data[target].iloc[-12]

        X_test = pd.DataFrame([test_features], index=test_row.index)
        X_test = X_test[X_train.columns]

        scaler = StandardScaler()

        X_train_scaled = scaler.fit_transform(X_train)
        X_test_scaled = scaler.transform(X_test)

        model = Ridge(alpha=1.0)
        model.fit(X_train_scaled, y_train)

        pred = model.predict(X_test_scaled)[0]
        preds.append(pred)

    return pd.Series(preds, index=model_data.index[train_size:])

