def naive_horizon_forecast(series, test_size=12, horizon=1):
    series = series.dropna().copy()
    train_size = len(series) - test_size

    preds = []
    pred_index = []

    for i in range(train_size, len(series) - horizon + 1):
        history = series.iloc[:i]
        true_date = series.index[i + horizon - 1]

        preds.append(history.iloc[-1])
        pred_index.append(true_date)

    return pd.Series(preds, index=pred_index)


def seasonal_naive_horizon_forecast(series, test_size=12, season=12, horizon=1):
    series = series.dropna().copy()
    train_size = len(series) - test_size

    preds = []
    pred_index = []

    for i in range(train_size, len(series) - horizon + 1):
        true_pos = i + horizon - 1
        true_date = series.index[true_pos]
        seasonal_pos = true_pos - season

        if seasonal_pos >= 0 and seasonal_pos < i:
            pred = series.iloc[seasonal_pos]
        else:
            pred = series.iloc[i - 1]

        preds.append(pred)
        pred_index.append(true_date)

    return pd.Series(preds, index=pred_index)


def sarima_walk_forward_horizon(series, data_version, test_size=12, horizon=1):
    series = series.dropna().copy()
    train_size = len(series) - test_size

    preds = []
    pred_index = []

    for i in range(train_size, len(series) - horizon + 1):
        history = series.iloc[:i].copy()
        true_date = series.index[i + horizon - 1]

        model_fit = fit_sarima(history, data_version)
        forecast = model_fit.forecast(steps=horizon)

        preds.append(forecast.iloc[-1])
        pred_index.append(true_date)

    return pd.Series(preds, index=pred_index)


def var_walk_forward_horizon(model_data, target_cols, test_size=12, maxlags=2, horizon=1):
    model_data = model_data[target_cols].dropna().copy()
    train_size = len(model_data) - test_size

    preds = []
    pred_index = []

    for i in range(train_size, len(model_data) - horizon + 1):
        history = model_data.iloc[:i].copy()
        true_date = model_data.index[i + horizon - 1]

        lag = min(maxlags, max(1, len(history) // 10))
        model = VAR(history)
        model_fit = model.fit(lag)

        forecast = model_fit.forecast(
            history.values[-lag:],
            steps=horizon
        )[-1]

        preds.append(forecast)
        pred_index.append(true_date)

    return pd.DataFrame(
        preds,
        index=pred_index,
        columns=target_cols
    )


def make_ridge_train_features_horizon(train_data, target, features, horizon):
    train_frame = train_data[[target] + features].copy()

    train_frame[f'{target}_lag_1'] = train_frame[target].shift(1)
    train_frame[f'{target}_lag_12'] = train_frame[target].shift(12)
    train_frame['target_future'] = train_frame[target].shift(-horizon)

    return train_frame.dropna()


def ridge_walk_forward_horizon(model_data, target, features, test_size=12, horizon=1):
    model_data = model_data[[target] + features].dropna().copy()
    train_size = len(model_data) - test_size

    preds = []
    pred_index = []

    for i in range(train_size, len(model_data) - horizon + 1):
        train_data = model_data.iloc[:i].copy()
        true_date = model_data.index[i + horizon - 1]

        train_features = make_ridge_train_features_horizon(
            train_data,
            target,
            features,
            horizon
        )

        if train_features.empty:
            continue

        X_train = train_features.drop(columns=[target, 'target_future'])
        y_train = train_features['target_future']

        origin_row = train_data.iloc[-1]
        test_features = {}

        for col in features:
            test_features[col] = origin_row[col]

        test_features[f'{target}_lag_1'] = train_data[target].iloc[-1]
        test_features[f'{target}_lag_12'] = train_data[target].iloc[-12]

        X_test = pd.DataFrame([test_features], index=[true_date])
        X_test = X_test[X_train.columns]

        scaler = StandardScaler()
        X_train_scaled = scaler.fit_transform(X_train)
        X_test_scaled = scaler.transform(X_test)

        model = Ridge(alpha=1.0)
        model.fit(X_train_scaled, y_train)

        pred = model.predict(X_test_scaled)[0]

        preds.append(pred)
        pred_index.append(true_date)

    return pd.Series(preds, index=pred_index)


