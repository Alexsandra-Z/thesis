            })

            # для графиков сохраняем прогноз на 1 месяц вперед
            forecasts[(target, baseline_name, '-', data_version)] = horizon_forecasts[1]

        # SARIMA
        try:
            pred_sarima = sarima_walk_forward(series, data_version, TEST_SIZE)
            metrics = evaluate_model(test_series, pred_sarima)

            results.append({
                'target': target,
                'model': 'SARIMA',
                'specification': '-',
                'data_version': data_version,
                **metrics
            })

            forecasts[(target, 'SARIMA', '-', data_version)] = pred_sarima

        except Exception as e:
            print(f'{target}, {data_version}: SARIMA не построилась — {e}')

    # VAR только для индексов
    try:
        var_data = data[var_targets].dropna()

        if len(var_data) > TEST_SIZE + 20:
            pred_var = var_walk_forward(var_data, var_targets, TEST_SIZE)

            for target in var_targets:
                test_series = var_data[target].iloc[-TEST_SIZE:]
                metrics = evaluate_model(test_series, pred_var[target])

                results.append({
                    'target': target,
                    'model': 'VAR',
                    'specification': '-',
                    'data_version': data_version,
                    **metrics
                })

                forecasts[(target, 'VAR', '-', data_version)] = pred_var[target]

    except Exception as e:
        print(f'VAR, {data_version}: модель не построилась — {e}')

    # Ridge по спецификациям
    for target in targets:
        for spec_name, feature_list in specs.items():
            available_features = [
                col for col in feature_list
                if col in data.columns
            ]

            if len(available_features) == 0:
                continue

            try:
                pred_ridge = ridge_walk_forward(
                    model_data=data,
                    target=target,
                    features=available_features,
                    test_size=TEST_SIZE
                )

                ridge_data = data[[target] + available_features].dropna().copy()
                test_series = ridge_data[target].iloc[-TEST_SIZE:]

                metrics = evaluate_model(test_series, pred_ridge)

                results.append({
                    'target': target,
                    'model': 'Ridge',
                    'specification': spec_name,
                    'data_version': data_version,
                    **metrics
                })

                forecasts[(target, 'Ridge', spec_name, data_version)] = pred_ridge

            except Exception as e:
                print(f'{target}, {data_version}, {spec_name}: Ridge не построилась — {e}')

